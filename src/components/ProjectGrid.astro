---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'work'>[];
  id?: string;
}

const { projects, id = 'work-grid' } = Astro.props;
const filters = ['Featured', 'All', 'AI', 'Products', 'Design', 'Partnerships', 'Fintech', 'OnePlus'];
---

<div class="grid-wrap" id={id} data-filter-grid>
  <div class="filter-bar" role="group" aria-label="Filter projects by category">
    {
      filters.map((f, i) => (
        <a
          href={f === 'All' ? Astro.url.pathname : `?category=${f.toLowerCase()}`}
          class="filter-pill"
          data-filter={f.toLowerCase()}
          role="button"
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f}
        </a>
      ))
    }
  </div>
  <div class="grid stagger">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
  <div class="view-all-wrap" data-view-all>
    <button class="view-all-link" data-filter-all>View all projects →</button>
  </div>
</div>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    /* Stays pinned below the nav while the grid is in view */
    position: sticky;
    top: 60px;
    z-index: 20;
    padding: 0.7rem 0;
    background: var(--nav-bg);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
  }
  .filter-pill {
    background: var(--bg);
  }
  .filter-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .filter-pill:hover {
    color: var(--text-1);
    border-color: var(--border-hover);
  }
  .filter-pill[aria-pressed='true'] {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }
  .view-all-wrap {
    text-align: center;
    margin-top: 2.5rem;
  }
  .view-all-link {
    font-size: var(--text-sm);
    font-family: var(--font-body);
    color: var(--text-2);
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 0 0 0.1rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .view-all-link:hover {
    color: var(--text-1);
    border-color: var(--border-hover);
  }
  .view-all-wrap[hidden] {
    display: none;
  }
  .grid {
    display: grid;
    /* min() keeps cards from overflowing viewports narrower than 310px + padding */
    grid-template-columns: repeat(auto-fill, minmax(min(310px, 100%), 1fr));
    gap: 1.5rem;
  }
</style>

<script>
  import { initFilterGrids } from '../scripts/filter-grid';
  initFilterGrids();

  // Show "View all projects" only when the featured filter is active.
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-filter-grid]')) {
    const viewAllWrap = wrap.querySelector<HTMLElement>('[data-view-all]');
    const viewAllLink = wrap.querySelector<HTMLAnchorElement>('[data-filter-all]');
    if (!viewAllWrap || !viewAllLink) continue;

    const sync = () => {
      const active = wrap.querySelector<HTMLElement>('.filter-pill[aria-pressed="true"]');
      const isFeatured = active?.dataset.filter === 'featured';
      viewAllWrap.hidden = !isFeatured;
    };

    viewAllLink.addEventListener('click', () => {
      const allPill = wrap.querySelector<HTMLAnchorElement>('.filter-pill[data-filter="all"]');
      allPill?.click();
    });

    wrap.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.filter-pill')) setTimeout(sync, 0);
    });

    sync();
  }
</script>
