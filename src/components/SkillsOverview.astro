---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'work'>[];
}

const { projects } = Astro.props;

const bySkill = new Map<string, CollectionEntry<'work'>[]>();
for (const p of projects) {
  for (const skill of p.data.skills) {
    if (!bySkill.has(skill)) bySkill.set(skill, []);
    bySkill.get(skill)!.push(p);
  }
}

// Cross-cutting skills (used on 2+ projects) make the overview a "where have
// you applied this" view rather than repeating each project's full tag list.
const entries = [...bySkill.entries()]
  .filter(([, ps]) => ps.length > 1)
  .sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
---

{
  entries.length > 0 && (
    <section class="skills-overview">
      <p class="section-label reveal">// skills across the work</p>
      <h2 class="section-title reveal">Skills by project</h2>
      <p class="section-sub reveal">
        The product, strategy and partnership skills that recur across the work. Each case study lists its full skill set.
      </p>
      <div class="skills-grid stagger">
        {entries.map(([skill, ps]) => (
          <div class="skill-row">
            <span class="tag tag-skill skill-name">{skill}</span>
            <div class="skill-projects">
              {ps.map((p) => (
                <a href={`/work/${p.id}/`} class="skill-project-link">
                  {p.data.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .skills-overview {
    margin-top: var(--space-section);
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  .skill-row {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .skill-name {
    align-self: flex-start;
  }
  .skill-projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.8rem;
  }
  .skill-project-link {
    font-size: var(--text-xs);
    color: var(--text-3);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
  }
  .skill-project-link:hover {
    color: var(--text-1);
    border-color: var(--accent);
  }
</style>
