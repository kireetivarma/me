---
import { Image } from 'astro:assets';
import stationMockup from '../../assets/work/ncs/station-mockup.png';
interface Props { size?: 'thumb' | 'hero' | 'ambient' }
const { size = 'thumb' } = Astro.props;
---

<div class:list={['art', 'charging-art', size]} aria-hidden="true">
  <div class="scene">
    <div class="stage">
      <Image class="illo" src={stationMockup} alt="" widths={[520, 860]} sizes="(max-width: 700px) 520px, 860px" />
      <!-- Steps walked from the phone toward the station, lighting up in sequence -->
      <span class="step s1"></span>
      <span class="step s2"></span>
      <span class="step s3"></span>
      <span class="step s4"></span>
      <!-- Charge pulse at the station once the walk completes -->
      <span class="charge"></span>
      <!-- Live step counter, the feature's signature -->
      <span class="dist art-mono"><b></b></span>
    </div>
  </div>
</div>

<style>
  .charging-art { background-image: radial-gradient(ellipse at 72% 22%, rgba(16, 185, 129, 0.14), transparent 62%); }
  .scene {
    width: 86cqw;
    background: #eceef3;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 4cqw;
    padding: 3.5cqw;
    box-shadow: 0 5cqw 16cqw rgba(0, 0, 0, 0.32);
  }
  /* Aspect matches the illustration so percentage-positioned overlays land precisely. */
  .stage {
    position: relative;
    aspect-ratio: 4320 / 2520;
  }
  .illo { display: block; width: 100%; height: 100%; object-fit: contain; }

  .step {
    position: absolute;
    width: 2.6cqw;
    height: 2.6cqw;
    border-radius: 50%;
    background: #10b981;
    top: 58%;
    opacity: 0;
    box-shadow: 0 0 2.4cqw rgba(16, 185, 129, 0.7);
  }
  .s1 { left: 30%; animation: step 5.5s ease infinite 0.2s; }
  .s2 { left: 35%; animation: step 5.5s ease infinite 0.7s; }
  .s3 { left: 40%; animation: step 5.5s ease infinite 1.2s; }
  .s4 { left: 45%; animation: step 5.5s ease infinite 1.7s; }
  @keyframes step {
    0%, 2% { opacity: 0; transform: scale(0.4); }
    10% { opacity: 1; transform: scale(1); }
    62% { opacity: 1; transform: scale(1); }
    72%, 100% { opacity: 0; transform: scale(0.4); }
  }

  .charge {
    position: absolute;
    left: 61%;
    top: 40%;
    width: 6cqw;
    height: 6cqw;
    border-radius: 50%;
    border: 0.7cqw solid #10b981;
    opacity: 0;
    animation: charge 5.5s ease-out infinite;
  }
  @keyframes charge {
    0%, 62% { opacity: 0; transform: scale(0.5); }
    66% { opacity: 1; transform: scale(0.7); }
    100% { opacity: 0; transform: scale(2.6); }
  }

  .dist {
    position: absolute;
    left: 50%;
    top: 2%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 3cqw;
    color: #047857;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 99px;
    padding: 1cqw 2.6cqw;
    box-shadow: 0 1.5cqw 5cqw rgba(0, 0, 0, 0.12);
  }
  .dist b::before {
    content: '142 steps';
    font-weight: 600;
    animation: count 5.5s steps(1) infinite;
  }
  @keyframes count {
    0% { content: '142 steps'; }
    18% { content: '96 steps'; }
    36% { content: '54 steps'; }
    54% { content: '18 steps'; }
    66%, 100% { content: 'Arrived ✓'; }
  }
</style>
