---
interface Props { size?: 'thumb' | 'hero' | 'ambient' }
const { size = 'thumb' } = Astro.props;
---

<div class:list={['art', 'charging-art', size]} aria-hidden="true">
  <div class="scene">
    <svg class="ncs" viewBox="0 0 340 200" role="img" aria-hidden="true">
      <!-- station: depth slab behind, then body -->
      <g fill="var(--st2)">
        <rect x="188" y="74" width="128" height="32" rx="7" />
        <rect x="188" y="102" width="22" height="90" rx="6" />
        <rect x="294" y="102" width="22" height="90" rx="6" />
        <rect x="238" y="48" width="28" height="30" rx="6" />
      </g>
      <g fill="var(--st)">
        <rect x="182" y="70" width="128" height="32" rx="7" />
        <rect x="182" y="98" width="22" height="90" rx="6" />
        <rect x="288" y="98" width="22" height="90" rx="6" />
        <rect x="232" y="44" width="28" height="30" rx="6" />
      </g>
      <!-- OnePlus mark on the tower -->
      <rect x="240" y="52" width="11" height="11" rx="1.6" fill="none" stroke="#fff" stroke-width="1.4" />
      <rect x="244.6" y="54.5" width="1.5" height="6" fill="#fff" />
      <rect x="253" y="51" width="4" height="1.4" fill="#fff" />
      <rect x="254.3" y="49.7" width="1.4" height="4" fill="#fff" />
      <!-- charging sockets -->
      <g fill="var(--socket)">
        <rect x="196" y="78" width="22" height="18" rx="3" />
        <rect x="274" y="78" width="22" height="18" rx="3" />
      </g>
      <g fill="var(--socket-hole)">
        <circle cx="203" cy="84" r="1.6" /><circle cx="203" cy="90" r="1.6" /><circle cx="210" cy="87" r="1.6" />
        <circle cx="281" cy="84" r="1.6" /><circle cx="281" cy="90" r="1.6" /><circle cx="288" cy="87" r="1.6" />
      </g>
      <g fill="var(--st2)">
        <rect x="233" y="80" width="3" height="12" rx="1.5" /><rect x="239" y="80" width="3" height="12" rx="1.5" />
        <rect x="251" y="80" width="3" height="12" rx="1.5" /><rect x="257" y="80" width="3" height="12" rx="1.5" />
      </g>
      <!-- charge pulse at the live socket -->
      <circle class="charge" cx="207" cy="87" r="6" fill="none" stroke="#10b981" stroke-width="2" />

      <!-- low-battery phone -->
      <rect x="26" y="40" width="70" height="148" rx="14" fill="var(--ph-frame)" />
      <rect x="32" y="46" width="58" height="136" rx="9" fill="var(--ph-screen)" />
      <rect x="52" y="104" width="18" height="30" rx="3" fill="none" stroke="#3b4252" stroke-width="2" />
      <rect x="57.5" y="101" width="7" height="3" rx="1" fill="#3b4252" />
      <rect x="54" y="126" width="14" height="6" rx="1.5" fill="#e11d48" />
      <path d="M62 109 l-4 8 h3 l-1.5 6 5.5 -9 h-3 z" fill="#e11d48" />

      <!-- footprints walking toward the station -->
      <g fill="#10b981">
        <g transform="translate(116,166) rotate(22)"><g class="step s1"><ellipse rx="4.4" ry="6.4" /><ellipse cx="-1.6" cy="9" rx="2.5" ry="3.3" /></g></g>
        <g transform="translate(132,158) rotate(30)"><g class="step s2"><ellipse rx="4.4" ry="6.4" /><ellipse cx="-1.6" cy="9" rx="2.5" ry="3.3" /></g></g>
        <g transform="translate(148,166) rotate(22)"><g class="step s3"><ellipse rx="4.4" ry="6.4" /><ellipse cx="-1.6" cy="9" rx="2.5" ry="3.3" /></g></g>
        <g transform="translate(164,158) rotate(30)"><g class="step s4"><ellipse rx="4.4" ry="6.4" /><ellipse cx="-1.6" cy="9" rx="2.5" ry="3.3" /></g></g>
      </g>
    </svg>
    <span class="dist art-mono"><b></b></span>
  </div>
</div>

<style>
  .charging-art {
    background-image: radial-gradient(ellipse at 66% 32%, rgba(16, 185, 129, 0.16), transparent 62%);
    --st: #6b7280;
    --st2: #565d6e;
    --socket: #474d5c;
    --socket-hole: #2f3443;
    --ph-frame: #2f3447;
    --ph-screen: #0f111a;
    /* Soft halo to lift the dark phone off a dark background; off in light mode. */
    --phone-glow: rgba(148, 163, 184, 0.3);
  }
  [data-theme='light'] .charging-art { --phone-glow: transparent; }

  .scene { position: relative; width: 96%; }
  .ncs { display: block; width: 100%; height: auto; overflow: visible; }
  /* Halo behind the phone (left ~quarter of the scene). */
  .ncs::after { content: none; }
  .scene::before {
    content: '';
    position: absolute;
    left: 2%;
    top: 14%;
    width: 26%;
    height: 78%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--phone-glow), transparent 76%);
  }

  .step {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  .s1 { animation: ncs-step 5.5s ease infinite 0.2s; }
  .s2 { animation: ncs-step 5.5s ease infinite 0.7s; }
  .s3 { animation: ncs-step 5.5s ease infinite 1.2s; }
  .s4 { animation: ncs-step 5.5s ease infinite 1.7s; }
  @keyframes ncs-step {
    0%, 2% { opacity: 0; transform: scale(0.3); }
    12% { opacity: 1; transform: scale(1); }
    62% { opacity: 1; transform: scale(1); }
    72%, 100% { opacity: 0; transform: scale(0.3); }
  }

  .charge {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: ncs-charge 5.5s ease-out infinite;
  }
  @keyframes ncs-charge {
    0%, 62% { opacity: 0; transform: scale(0.4); }
    66% { opacity: 1; transform: scale(0.7); }
    100% { opacity: 0; transform: scale(2.8); }
  }

  .dist {
    position: absolute;
    left: 41%;
    top: 61%;
    transform: translate(-50%, -50%);
    font-size: 3cqw;
    color: #10b981;
    background: var(--bg-2);
    border: 1px solid var(--art-stroke);
    border-radius: 99px;
    padding: 0.9cqw 2.4cqw;
    box-shadow: 0 1.5cqw 5cqw rgba(0, 0, 0, 0.18);
    white-space: nowrap;
  }
  .dist b::before {
    content: '96 steps';
    font-weight: 600;
    animation: ncs-count 5.5s steps(1) infinite;
  }
  @keyframes ncs-count {
    0% { content: '96 steps'; }
    24% { content: '54 steps'; }
    48% { content: '18 steps'; }
    66%, 100% { content: 'Arrived ✓'; }
  }
</style>
