---
interface Props { size?: 'thumb' | 'hero' | 'ambient' }
const { size = 'thumb' } = Astro.props;
---

<div class:list={['art', 'spotify-art', size]} aria-hidden="true">
  <div class="art-widget card">
    <div class="album"></div>
    <div class="meta">
      <div class="line lg"></div>
      <div class="line"></div>
      <div class="eq">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
    </div>
    <div class="play">▶</div>
  </div>
</div>

<style>
  .spotify-art { background: radial-gradient(ellipse at 20% 80%, rgba(29, 185, 84, 0.16), transparent 60%); }
  .card {
    width: 68cqw;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 5cqw;
    align-items: center;
  }
  .album {
    width: 16cqw;
    height: 16cqw;
    border-radius: 3cqw;
    background:
      linear-gradient(135deg, #1db954 0%, #14532d 60%, #052e16 100%);
    box-shadow: 0 2cqw 8cqw rgba(29, 185, 84, 0.4);
    animation: tilt 6s ease-in-out infinite;
  }
  .line {
    height: 2.4cqw;
    width: 60%;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.2);
    margin-bottom: 2cqw;
  }
  .line.lg { width: 90%; background: rgba(255, 255, 255, 0.45); }
  .eq {
    display: flex;
    gap: 1.2cqw;
    align-items: flex-end;
    height: 5cqw;
    margin-top: 2.5cqw;
  }
  .eq i {
    width: 1.4cqw;
    background: #1db954;
    border-radius: 99px;
    animation: eq 1s ease-in-out infinite alternate;
  }
  .eq i:nth-child(1) { height: 40%; animation-delay: 0s; }
  .eq i:nth-child(2) { height: 90%; animation-delay: 0.15s; }
  .eq i:nth-child(3) { height: 60%; animation-delay: 0.3s; }
  .eq i:nth-child(4) { height: 100%; animation-delay: 0.45s; }
  .eq i:nth-child(5) { height: 50%; animation-delay: 0.6s; }
  .play {
    width: 9cqw;
    height: 9cqw;
    border-radius: 50%;
    background: #1db954;
    color: #04130a;
    display: grid;
    place-items: center;
    font-size: 3.6cqw;
    padding-left: 0.8cqw;
  }
  @keyframes eq {
    to { transform: scaleY(0.35); }
  }
  @keyframes tilt {
    50% { transform: rotate(-4deg) translateY(-3%); }
  }
</style>
