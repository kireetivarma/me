---
interface Props { size?: 'thumb' | 'hero' | 'ambient' }
const { size = 'thumb' } = Astro.props;
---

<div class:list={['art', 'labh-art', size]} aria-hidden="true">
  <div class="panel">
    <div class="head">
      <span class="ticker art-mono">NIFTY 50</span>
      <span class="delta art-mono">+12.4%</span>
    </div>
    <svg viewBox="0 0 200 80" preserveAspectRatio="none" class="chart">
      <path class="area" d="M0,70 L20,62 L40,66 L60,50 L80,55 L100,38 L120,42 L140,26 L160,30 L180,14 L200,18 L200,80 L0,80 Z" />
      <path class="line" d="M0,70 L20,62 L40,66 L60,50 L80,55 L100,38 L120,42 L140,26 L160,30 L180,14 L200,18" />
      <circle class="tip" cx="200" cy="18" r="3" />
    </svg>
  </div>
</div>

<style>
  .labh-art { background: radial-gradient(ellipse at 80% 20%, rgba(16, 185, 129, 0.14), transparent 60%); }
  .panel {
    width: 70cqw;
    border-radius: 5cqw;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    padding: 5cqw;
  }
  [data-theme='light'] .panel { background: rgba(255, 255, 255, 0.8); border-color: rgba(0, 0, 0, 0.08); }
  .head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 3cqw;
    font-size: 3.4cqw;
  }
  .ticker { color: var(--text-2); }
  .delta { color: #10b981; animation: tick 4s steps(1) infinite; }
  .chart { width: 100%; height: 28cqw; overflow: visible; }
  .line {
    fill: none;
    stroke: #10b981;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    animation: draw 3.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .area {
    fill: url(#g) rgba(16, 185, 129, 0.12);
    fill: rgba(16, 185, 129, 0.12);
    opacity: 0;
    animation: fade 1s ease 2.4s forwards;
  }
  .tip {
    fill: #10b981;
    opacity: 0;
    animation: fade 0.5s ease 3s forwards, blip 2s ease 3s infinite;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes blip { 50% { r: 4.5; } }
  @keyframes tick {
    0% { content: ''; opacity: 1; }
    50% { opacity: 0.75; }
  }
</style>
