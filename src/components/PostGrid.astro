---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const filters = ['All', 'Product', 'Design', 'Development', 'Consulting', 'Review', 'Partnership', 'Personal', 'Tech'];
/* Posts in only these categories stay out of the default "All" view. */
const HIDE_FROM_ALL = ['Personal', 'Review', 'Tech'];
const hideFromAll = (p: CollectionEntry<'posts'>) => p.data.categories.every((c) => HIDE_FROM_ALL.includes(c));
---

<div class="grid-wrap" data-filter-grid>
  <div class="filter-bar" role="group" aria-label="Filter posts by category">
    {
      filters.map((f, i) => (
        <a
          href={f === 'All' ? Astro.url.pathname : `?category=${f.toLowerCase()}`}
          class="filter-pill"
          data-filter={f.toLowerCase()}
          role="button"
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f}
        </a>
      ))
    }
  </div>
  <div class="grid stagger">
    {posts.map((p) => <PostCard post={p} hideFromAll={hideFromAll(p)} />)}
  </div>
</div>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .filter-pill:hover {
    color: var(--text-1);
    border-color: var(--border-hover);
  }
  .filter-pill[aria-pressed='true'] {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }
  .grid {
    display: grid;
    /* min() keeps cards from overflowing viewports narrower than 310px + padding */
    grid-template-columns: repeat(auto-fill, minmax(min(310px, 100%), 1fr));
    gap: 1.5rem;
  }
</style>

<script>
  import { initFilterGrids } from '../scripts/filter-grid';
  initFilterGrids();
</script>
