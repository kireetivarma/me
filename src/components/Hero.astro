---
import { profile } from '../data/profile';
import StatsRow from './StatsRow.astro';
---

<section class="hero">
  <div class="container">
    <p class="eyebrow reveal art-mono">// {profile.title.toLowerCase()}</p>
    <h1 class="reveal">
      Designer turned<br />
      <em>Product Builder</em><br />
      at global scale.
    </h1>
    <p class="hero-sub reveal">
      Senior Product Manager, ex-OnePlus, 1x founder — now building with AI.
      Crafting mobile &amp; web experiences for <b>200M+ users</b> across <b>50+ countries</b>,
      with partnerships spanning Spotify, Netflix, Snapchat, Zomato &amp; more.
    </p>
    <p class="hero-loc reveal">{profile.location}</p>
    <div class="hero-cta reveal">
      <a href="/work/" class="btn btn-primary">Explore my work →</a>
      <a href={profile.social.calendly} target="_blank" rel="noopener" class="btn btn-outline">Schedule a call</a>
    </div>
    <StatsRow />
  </div>
</section>

<style>
  .hero {
    padding: calc(var(--space-section) * 0.9) 0 var(--space-section);
    position: relative;
  }
  .eyebrow {
    color: var(--red);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    margin-bottom: 1.2rem;
  }
  h1 {
    font-size: var(--text-hero);
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  h1 em {
    font-style: normal;
    background: linear-gradient(100deg, var(--red), #ff6b4a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    max-width: 56ch;
    color: var(--text-2);
    font-size: var(--text-lg);
    margin-bottom: 0.8rem;
  }
  .hero-sub b { color: var(--text-1); }
  .hero-loc {
    color: var(--text-3);
    font-size: var(--text-sm);
    margin-bottom: 2.2rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 3.5rem;
  }
</style>
