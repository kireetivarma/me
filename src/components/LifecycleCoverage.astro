---
import type { CollectionEntry } from 'astro:content';
import {
  lifecycle,
  STAGES,
  STAGE_FULL,
  type LifecycleStage,
} from '../data/lifecycle.ts';

interface Props {
  projects: CollectionEntry<'work'>[];
}
const { projects } = Astro.props;

const projectMap = new Map(projects.map((p) => [p.id, p]));

const rows = lifecycle
  .map((l) => ({ lc: l, project: projectMap.get(l.slug) }))
  .filter((r): r is { lc: (typeof lifecycle)[number]; project: CollectionEntry<'work'> } => !!r.project);

const stateClass = (s?: string) => (s === 'led' ? 'led' : s === 'co' ? 'co' : s === 'supported' ? 'supported' : 'none');
const stateWord = (s?: string) =>
  s === 'led' ? 'Led' : s === 'co' ? 'Co-led' : s === 'supported' ? 'Supported' : 'Not involved';
---

<section class="section lc-section">
  <div class="container">
    <p class="section-label reveal">// full-stack product</p>
    <h2 class="section-title reveal">Full Stack Product</h2>
    <p class="section-sub reveal">
      One product mind across the whole lifecycle, from discovery to ops over a decade. Tap any project to see the proof.
    </p>

    <div class="lc-wrap reveal">
      <div class="lc-grid" role="table" aria-label="Product lifecycle coverage by project">
        <!-- Stage header row -->
        <div class="lc-head" role="row">
          <span class="lc-corner" role="columnheader" aria-label="Project"></span>
          <div class="lc-stages">
            {
              STAGES.map((s: LifecycleStage) => (
                <span class="lc-th art-mono" role="columnheader" aria-label={STAGE_FULL[s]}>
                  {STAGE_FULL[s]}
                </span>
              ))
            }
          </div>
        </div>

        {
          rows.map(({ lc, project }) => {
            const detailId = `lc-d-${lc.slug}`;
            return (
              <div class="lc-item">
                <button
                  class="lc-row"
                  type="button"
                  aria-expanded="false"
                  aria-controls={detailId}
                >
                  <span class="lc-name">{project.data.title}</span>
                  <span class="lc-track" role="img" aria-label={STAGES.map((s) => `${STAGE_FULL[s]}: ${stateWord(lc.stages[s])}`).join(', ')}>
                    {STAGES.map((s: LifecycleStage) => (
                      <span class={`seg ${stateClass(lc.stages[s])}`} />
                    ))}
                  </span>
                  <span class="lc-chev" aria-hidden="true">+</span>
                </button>
                <div class="lc-detail" id={detailId} hidden>
                  <ul class="lc-phase-list">
                    {STAGES.filter((s) => lc.stages[s] && lc.phaseLines[s]).map((s) => (
                      <li class="lc-phase-item">
                        <span class={`lc-phase-dot seg ${stateClass(lc.stages[s])}`} aria-hidden="true" />
                        <span class="lc-phase-label">{STAGE_FULL[s]}</span>
                        <span class="lc-phase-line">{lc.phaseLines[s]}</span>
                      </li>
                    ))}
                  </ul>
                  <a href={`/work/${lc.slug}/`} class="lc-link">
                    View project →
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Legend -->
    <div class="lc-legend reveal">
      <span class="lc-key"><span class="seg led key-seg"></span> Led</span>
      <span class="lc-key"><span class="seg co key-seg"></span> Co-led</span>
      <span class="lc-key"><span class="seg supported key-seg"></span> Supported</span>
      <span class="lc-key"><span class="seg none key-seg"></span> Not involved</span>
    </div>
  </div>
</section>

<style>
  .lc-section {
    --name-w: clamp(84px, 22vw, 150px);
    --seg-h: 24px;
    --seg-gap: 3px;
  }

  .lc-wrap {
    margin-top: 1.8rem;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }
  .lc-grid {
    min-width: 580px;
  }

  /* Header + rows share the same two-track layout. */
  .lc-head,
  .lc-row {
    display: grid;
    grid-template-columns: var(--name-w) 1fr;
    align-items: end;
  }

  /* Sticky header: stays below the fixed 60px nav while scrolling vertically. */
  .lc-head {
    position: sticky;
    top: 60px;
    z-index: 3;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.4rem;
  }

  .lc-corner {
    position: sticky;
    left: 0;
    background: var(--bg);
    z-index: 4;
  }

  .lc-stages {
    display: flex;
    gap: var(--seg-gap);
    padding-left: 0.6rem;
    align-items: flex-end;
  }
  .lc-th {
    flex: 1;
    text-align: center;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding-bottom: 0.3rem;
    height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }

  .lc-item {
    border-bottom: 1px solid var(--border);
  }
  .lc-item:last-child {
    border-bottom: 0;
  }

  .lc-row {
    width: 100%;
    background: none;
    border: 0;
    padding: 0.45rem 0;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
    grid-template-columns: var(--name-w) 1fr auto;
    gap: 0;
    align-items: center;
    transition: background 0.2s;
  }
  .lc-row:hover .lc-name,
  .lc-row:focus-visible .lc-name {
    color: var(--text-1);
  }
  .lc-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Sticky name column: stays pinned during horizontal scroll. */
  .lc-name {
    position: sticky;
    left: 0;
    background: var(--bg);
    z-index: 2;
    padding-right: 0.55rem;
    border-right: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-2);
    white-space: normal;
    word-break: break-word;
    line-height: 1.25;
    transition: color 0.2s;
  }

  /* Track: one bar with 8 stage segments. */
  .lc-track {
    display: flex;
    gap: var(--seg-gap);
    height: var(--seg-h);
    padding: 0 0.6rem;
    align-items: center;
  }
  .seg {
    flex: 1;
    height: 100%;
    border-radius: 3px;
    min-width: 8px;
  }

  /* 3-step opaque intensity ramp. */
  .seg.led {
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 88%, #fff 12%), var(--accent));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .seg.co {
    background: color-mix(in srgb, var(--accent) 55%, var(--bg-2));
  }
  .seg.supported {
    background: color-mix(in srgb, var(--accent) 22%, var(--bg-2));
  }
  .seg.none {
    background: var(--bg-2);
    border: 1px solid var(--border);
  }

  .lc-chev {
    align-self: center;
    padding-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-3);
    transition: transform 0.2s, color 0.2s;
  }
  .lc-row[aria-expanded='true'] .lc-chev {
    transform: rotate(45deg);
    color: var(--accent);
  }

  /* Detail panel: per-phase one-liners. */
  .lc-detail {
    padding: 0.6rem 0.6rem 1rem;
  }
  .lc-detail[hidden] {
    display: none;
  }

  .lc-phase-list {
    list-style: none;
    margin: 0 0 0.8rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .lc-phase-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-sm);
  }
  .lc-phase-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  .lc-phase-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    min-width: 5.5rem;
  }
  .lc-phase-line {
    color: var(--text-2);
    line-height: 1.4;
  }

  .lc-link {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .lc-link:hover {
    text-decoration: underline;
  }

  /* Legend */
  .lc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    margin-top: 1.4rem;
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .lc-key {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .key-seg {
    width: 26px;
    height: 12px;
    flex: none;
    display: inline-block;
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .lc-section {
      --name-w: clamp(72px, 26vw, 120px);
      --seg-h: 20px;
      --seg-gap: 2px;
    }
    .lc-th {
      font-size: 0.58rem;
      height: 4.8rem;
    }
    .lc-phase-label {
      min-width: 4.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lc-chev {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.lc-row').forEach((row) => {
    row.addEventListener('click', () => {
      const panel = row.nextElementSibling as HTMLElement | null;
      if (!panel || !panel.classList.contains('lc-detail')) return;
      const open = row.getAttribute('aria-expanded') === 'true';
      row.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });
</script>
