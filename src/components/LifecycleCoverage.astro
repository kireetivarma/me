---
import type { CollectionEntry } from 'astro:content';
import {
  lifecycle,
  STAGES,
  STAGE_FULL,
  type LifecycleStage,
} from '../data/lifecycle.ts';

interface Props {
  projects: CollectionEntry<'work'>[];
}
const { projects } = Astro.props;

const projectMap = new Map(projects.map((p) => [p.id, p]));

const ledCount = (lc: (typeof lifecycle)[number]) =>
  Object.values(lc.stages).filter((v) => v === 'led').length;
const coCount = (lc: (typeof lifecycle)[number]) =>
  Object.values(lc.stages).filter((v) => v === 'co').length;

const rows = lifecycle
  .map((l) => ({ lc: l, project: projectMap.get(l.slug) }))
  .filter((r): r is { lc: (typeof lifecycle)[number]; project: CollectionEntry<'work'> } => !!r.project)
  .sort((a, b) => {
    const diff = ledCount(b.lc) - ledCount(a.lc);
    return diff !== 0 ? diff : coCount(b.lc) - coCount(a.lc);
  });

const STAGE_ABBR: Record<LifecycleStage, string> = {
  discovery: 'Disc',
  research: 'Rsch',
  strategy: 'Stgy',
  design: 'Dsgn',
  build: 'Build',
  test: 'Test',
  launch: 'Launch',
  ops: 'Ops',
};

const stateClass = (s?: string) => (s === 'led' ? 'led' : s === 'co' ? 'co' : s === 'supported' ? 'supported' : 'none');
const stateWord = (s?: string) =>
  s === 'led' ? 'Led' : s === 'co' ? 'Co-led' : s === 'supported' ? 'Supported' : 'Not involved';
---

<section class="section lc-section">
  <div class="container">
    <p class="section-label reveal">// full-stack product</p>
    <h2 class="section-title reveal">Full Stack Product</h2>
    <p class="section-sub reveal">
      From ideation to launch and ops, full product ownership across 20+ products and a decade of shipping. Tap any project to see the proof.
    </p>

    <!--
      Stage header lives OUTSIDE the overflow-x scroll container so that
      position:sticky;top:60px is relative to the viewport, not the scroll box.
      It must also NOT be inside any element with transform (e.g. .reveal) as
      that would create a new stacking context and break sticky.
    -->
    <div class="lc-head-wrap">
      <div class="lc-head" role="row" aria-label="Stage columns">
        <span class="lc-corner" role="columnheader" aria-label="Project"></span>
        <div class="lc-stages">
          {
            STAGES.map((s: LifecycleStage) => (
              <span class="lc-th art-mono" role="columnheader" title={STAGE_FULL[s]}>
                <span class="th-full">{STAGE_FULL[s]}</span>
                <span class="th-abbr">{STAGE_ABBR[s]}</span>
              </span>
            ))
          }
        </div>
        <span class="lc-chev-spacer" aria-hidden="true">+</span>
      </div>
    </div>

    <div class="lc-wrap">
      <div class="lc-grid" role="table" aria-label="Product lifecycle coverage by project">
        {
          rows.map(({ lc, project }) => {
            const detailId = `lc-d-${lc.slug}`;
            return (
              <div class="lc-item">
                <button
                  class="lc-row"
                  type="button"
                  aria-expanded="false"
                  aria-controls={detailId}
                >
                  <span class="lc-name">{project.data.title}</span>
                  <span class="lc-track" role="img" aria-label={STAGES.map((s) => `${STAGE_FULL[s]}: ${stateWord(lc.stages[s])}`).join(', ')}>
                    {STAGES.map((s: LifecycleStage) => (
                      <span class={`seg ${stateClass(lc.stages[s])}`} />
                    ))}
                  </span>
                  <span class="lc-chev" aria-hidden="true">+</span>
                </button>
                <div class="lc-detail" id={detailId} hidden>
                  <ul class="lc-phase-list">
                    {STAGES.filter((s) => lc.stages[s] && lc.phaseLines[s]).map((s) => (
                      <li class="lc-phase-item">
                        <span class={`lc-phase-dot seg ${stateClass(lc.stages[s])}`} aria-hidden="true" />
                        <span class="lc-phase-label">{STAGE_ABBR[s]}</span>
                        <span class="lc-phase-line">{lc.phaseLines[s]}</span>
                      </li>
                    ))}
                  </ul>
                  <a href={`/work/${lc.slug}/`} class="lc-link">
                    View project →
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Legend -->
    <div class="lc-legend reveal">
      <span class="lc-key"><span class="seg led key-seg"></span> Led</span>
      <span class="lc-key"><span class="seg co key-seg"></span> Co-led</span>
      <span class="lc-key"><span class="seg supported key-seg"></span> Supported</span>
      <span class="lc-key"><span class="seg none key-seg"></span> Not involved</span>
    </div>
  </div>
</section>

<style>
  .lc-section {
    --name-w: clamp(84px, 22vw, 150px);
    --seg-h: 22px;
    --seg-gap: 3px;
  }

  /* ── Sticky header wrapper ───────────────────────────────────────────────
     Sits OUTSIDE the overflow-x scroll container so sticky works relative
     to the viewport. overflow:hidden lets JS sync scrollLeft from the body. */
  .lc-head-wrap {
    position: sticky;
    top: 60px;
    z-index: 10;
    overflow: hidden;
    margin-top: 0.6rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* Header row: same 3-column grid as .lc-row so columns align. */
  .lc-head {
    display: grid;
    grid-template-columns: var(--name-w) 1fr auto;
    align-items: center;
    min-width: 420px;
    padding: 0.35rem 0;
  }

  /* Corner cell: opaque page background (NOT nav-bg glass) to avoid the
     visible frosted-rectangle artifact in light mode. */
  .lc-corner {
    position: sticky;
    left: 0;
    background: var(--bg);
    z-index: 4;
    align-self: stretch;
  }

  .lc-stages {
    display: flex;
    gap: var(--seg-gap);
    padding: 0 0.5rem;
  }
  .lc-th {
    flex: 1;
    text-align: center;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Responsive labels: show full words on desktop, abbreviations on mobile. */
  .th-abbr { display: none; }
  .th-full { display: inline; }

  /* Invisible spacer in header matching chev column so columns align. */
  .lc-chev-spacer {
    visibility: hidden;
    font-family: var(--font-mono);
    font-size: 1rem;
    padding-left: 0.6rem;
  }

  /* ── Scrollable body ─────────────────────────────────────────────────── */
  .lc-wrap {
    margin-top: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .lc-grid {
    min-width: 420px;
  }

  /* Header + rows share the same three-column layout. */
  .lc-row {
    display: grid;
    grid-template-columns: var(--name-w) 1fr auto;
    align-items: center;
  }

  .lc-item {
    border-bottom: 1px solid var(--border);
  }
  .lc-item:last-child {
    border-bottom: 0;
  }

  .lc-row {
    width: 100%;
    background: none;
    border: 0;
    padding: 0.35rem 0;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
    transition: background 0.2s;
  }
  .lc-row:hover .lc-name,
  .lc-row:focus-visible .lc-name {
    color: var(--text-1);
  }
  .lc-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Name column: sticky left, full row height, opaque bg + blur. */
  .lc-name {
    position: sticky;
    left: 0;
    background: var(--bg);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    z-index: 2;
    align-self: stretch;
    display: flex;
    align-items: center;
    padding-right: 0.5rem;
    border-right: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-2);
    white-space: normal;
    word-break: break-word;
    line-height: 1.25;
    transition: color 0.2s;
  }

  /* Track: one bar with 8 stage segments. */
  .lc-track {
    display: flex;
    gap: var(--seg-gap);
    height: var(--seg-h);
    padding: 0 0.5rem;
    align-items: center;
  }
  .seg {
    flex: 1;
    height: 100%;
    border-radius: 3px;
    min-width: 6px;
  }

  /* 3-step opaque intensity ramp. */
  .seg.led {
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 88%, #fff 12%), var(--accent));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .seg.co {
    background: color-mix(in srgb, var(--accent) 55%, var(--bg-2));
  }
  .seg.supported {
    background: color-mix(in srgb, var(--accent) 22%, var(--bg-2));
  }
  .seg.none {
    background: var(--bg-2);
    border: 1px solid var(--border);
  }

  .lc-chev {
    align-self: center;
    padding-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-3);
    transition: transform 0.2s, color 0.2s;
  }
  .lc-row[aria-expanded='true'] .lc-chev {
    transform: rotate(45deg);
    color: var(--accent);
  }

  /* Detail panel: per-phase one-liners, all same small size. */
  .lc-detail {
    padding: 0.5rem 0.5rem 0.9rem;
  }
  .lc-detail[hidden] {
    display: none;
  }

  .lc-phase-list {
    list-style: none;
    margin: 0 0 0.7rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .lc-phase-item {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: var(--text-xs);
  }
  .lc-phase-dot {
    flex: none;
    width: 9px;
    height: 9px;
    min-height: 9px;
    border-radius: 2px;
    margin-top: 0.15rem;
  }
  .lc-phase-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-3);
    min-width: 3.4rem;
  }
  .lc-phase-line {
    font-size: var(--text-xs);
    color: var(--text-2);
    line-height: 1.4;
  }

  .lc-link {
    font-size: var(--text-xs);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .lc-link:hover {
    text-decoration: underline;
  }

  /* Legend */
  .lc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    margin-top: 1.4rem;
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .lc-key {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .key-seg {
    width: 24px;
    height: 10px;
    flex: none;
    display: inline-block;
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .lc-section {
      --name-w: clamp(70px, 25vw, 110px);
      --seg-h: 18px;
      --seg-gap: 2px;
    }
    .lc-th {
      font-size: 0.55rem;
    }
    .lc-name {
      font-size: 0.78rem;
    }
    /* Switch to abbreviations on mobile. */
    .th-full { display: none; }
    .th-abbr { display: inline; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lc-chev {
      transition: none;
    }
  }
</style>

<script>
  // Sync horizontal scroll of the sticky header with the body scroll container.
  const headWrap = document.querySelector<HTMLElement>('.lc-head-wrap');
  const bodyWrap = document.querySelector<HTMLElement>('.lc-wrap');
  if (headWrap && bodyWrap) {
    bodyWrap.addEventListener('scroll', () => {
      headWrap.scrollLeft = bodyWrap.scrollLeft;
    });
  }

  // Expand/collapse rows.
  document.querySelectorAll<HTMLButtonElement>('.lc-row').forEach((row) => {
    row.addEventListener('click', () => {
      const panel = row.nextElementSibling as HTMLElement | null;
      if (!panel || !panel.classList.contains('lc-detail')) return;
      const open = row.getAttribute('aria-expanded') === 'true';
      row.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });
</script>
