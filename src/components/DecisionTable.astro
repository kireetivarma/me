---
/** "What was considered" table: the section that shows PM judgment. */
interface Props {
  title?: string;
  options: { option: string; why: string; whyNot?: string; chosen?: boolean }[];
}
const { title = 'What was considered', options } = Astro.props;
---

<div class="dt">
  <h3 class="dt-title">{title}</h3>
  <div class="dt-rows">
    {
      options.map((o) => (
        <div class:list={['dt-row', { chosen: o.chosen }]}>
          <div class="dt-option">
            {o.chosen && <span class="dt-badge">shipped</span>}
            {o.option}
          </div>
          <div class="dt-cell">
            <span class="dt-cell-label">Why considered</span>
            {o.why}
          </div>
          <div class="dt-cell">
            <span class="dt-cell-label">{o.chosen ? 'Trade-off accepted' : "Why it didn't ship"}</span>
            {o.whyNot}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .dt {
    margin: 2.5rem 0;
  }
  .dt-title {
    margin-bottom: 1rem;
  }
  .dt-rows {
    display: grid;
    gap: 0.7rem;
  }
  .dt-row {
    display: grid;
    grid-template-columns: minmax(150px, 1fr) 1.4fr 1.4fr;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 1.1rem 1.2rem;
  }
  .dt-row.chosen {
    border-color: var(--accent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 40%),
      var(--bg-card);
  }
  .dt-option {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-1);
  }
  .dt-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    margin-right: 0.5rem;
    vertical-align: 2px;
  }
  .dt-cell {
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .dt-cell-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
    margin-bottom: 0.3rem;
  }
  @media (max-width: 700px) {
    .dt-row {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }
</style>
