---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  images: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { title, images } = Astro.props;

const expanded = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: Math.min(img.src.width, 1800) }))
);
---

<div class="ic" data-img-carousel>
  {title && <h3 class="ic-title">{title}</h3>}
  <div class="ic-wrap">
    <div class="ic-track" tabindex="0" role="region" aria-label="Image gallery">
      {images.map((img, i) => (
        <div class="ic-slide">
          <button class="ic-zoom" type="button" aria-label={`View full size: ${img.alt}`} data-full={expanded[i].src}>
            <Image src={img.src} alt={img.alt} width={900} loading={i === 0 ? 'eager' : 'lazy'} />
          </button>
          {img.caption && <p class="ic-caption">{img.caption}</p>}
        </div>
      ))}
    </div>
    {images.length > 1 && (
      <>
        <button class="ic-arrow ic-prev" type="button" aria-label="Previous image">&#8249;</button>
        <button class="ic-arrow ic-next" type="button" aria-label="Next image">&#8250;</button>
      </>
    )}
  </div>
  {images.length > 1 && (
    <div class="ic-dots">
      {images.map((_, i) => (
        <button class="ic-dot" type="button" aria-label={`Image ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} data-idx={String(i)} />
      ))}
    </div>
  )}
</div>

<style>
  .ic { margin: 2.5rem 0; }
  .ic-title { margin-bottom: 1rem; }
  .ic-wrap {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-2);
  }
  .ic-track {
    display: flex;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    outline: none;
  }
  .ic-track::-webkit-scrollbar { display: none; }
  .ic-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  /* Fixed-height viewport keeps every slide equal so shorter images sit
     vertically centred instead of pinned to the top of a taller neighbour. */
  .ic-zoom {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: clamp(280px, 56vh, 560px);
    padding: 0;
    border: 0;
    background: var(--bg-2);
    cursor: zoom-in;
    overflow: hidden;
  }
  .ic-zoom :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .ic-caption {
    font-size: var(--text-xs);
    color: var(--text-3);
    padding: 0.5rem 0.8rem;
    text-align: center;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
  }
  .ic-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(12, 13, 17, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--text-1);
    font-size: 1.5rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: opacity 0.2s, background 0.2s;
    z-index: 2;
    line-height: 1;
    padding: 0;
  }
  .ic-prev { left: 0.6rem; }
  .ic-next { right: 0.6rem; }
  .ic-arrow:hover { background: rgba(12, 13, 17, 0.92); }
  .ic-arrow:disabled { opacity: 0.2; pointer-events: none; }
  .ic-dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  .ic-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 0;
    background: var(--border-hover);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .ic-dot[aria-selected='true'] {
    background: var(--accent);
    transform: scale(1.35);
  }
</style>

<script>
  type Shot = { src: string; alt: string };

  interface Lightbox {
    open(shots: Shot[], index: number): void;
  }

  function getLightbox(): Lightbox {
    let lb = document.getElementById('ag-lightbox') as HTMLElement | null;
    let shots: Shot[] = [];
    let idx = 0;

    if (!lb) {
      lb = document.createElement('div');
      lb.id = 'ag-lightbox';
      lb.setAttribute('role', 'dialog');
      lb.setAttribute('aria-modal', 'true');
      lb.style.cssText =
        'position:fixed;inset:0;z-index:2000;display:none;place-items:center;background:rgba(5,6,9,0.92);backdrop-filter:blur(8px);padding:4vmin;';
      lb.innerHTML =
        '<img id="lb-img" style="max-width:100%;max-height:92vh;border-radius:12px;box-shadow:0 24px 80px rgba(0,0,0,0.6);cursor:zoom-out" alt="" />' +
        '<button data-lb="prev" aria-label="Previous image" style="position:fixed;left:14px;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:0;background:rgba(255,255,255,0.12);color:#fff;font-size:2rem;cursor:pointer;display:grid;place-items:center;line-height:1">&#8249;</button>' +
        '<button data-lb="next" aria-label="Next image" style="position:fixed;right:14px;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:0;background:rgba(255,255,255,0.12);color:#fff;font-size:2rem;cursor:pointer;display:grid;place-items:center;line-height:1">&#8250;</button>' +
        '<span data-lb="count" style="position:fixed;bottom:18px;left:50%;transform:translateX(-50%);font-family:var(--font-mono);font-size:0.8rem;color:#cbd5e1"></span>' +
        '<button data-lb="close" aria-label="Close" style="position:fixed;top:14px;right:18px;background:none;border:0;color:#fff;font-size:1.8rem;cursor:pointer">&#215;</button>';
      document.body.appendChild(lb);
    }

    const root = lb;
    const big = root.querySelector<HTMLImageElement>('#lb-img')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-lb="prev"]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-lb="next"]')!;
    const counter = root.querySelector<HTMLElement>('[data-lb="count"]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-lb="close"]')!;

    const render = () => {
      const s = shots[idx];
      if (!s) return;
      big.src = s.src;
      big.alt = s.alt;
      const many = shots.length > 1;
      prevBtn.style.display = nextBtn.style.display = counter.style.display = many ? '' : 'none';
      counter.textContent = `${idx + 1} / ${shots.length}`;
    };
    const go = (n: number) => { idx = (n + shots.length) % shots.length; render(); };
    const close = () => { root.style.display = 'none'; document.documentElement.style.overflow = ''; };

    // Bind once; guarded by a flag so re-entrant getLightbox() calls don't stack listeners.
    if (!root.dataset.bound) {
      root.dataset.bound = 'true';
      prevBtn.addEventListener('click', (e) => { e.stopPropagation(); go(idx - 1); });
      nextBtn.addEventListener('click', (e) => { e.stopPropagation(); go(idx + 1); });
      closeBtn.addEventListener('click', (e) => { e.stopPropagation(); close(); });
      big.addEventListener('click', close);
      root.addEventListener('click', (e) => { if (e.target === root) close(); });
      addEventListener('keydown', (e) => {
        if (root.style.display === 'none') return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') go(idx - 1);
        if (e.key === 'ArrowRight') go(idx + 1);
      });
      // Swipe between images on touch.
      let x0: number | null = null;
      root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
        x0 = null;
      }, { passive: true });
    }

    return {
      open(s: Shot[], i: number) {
        shots = s;
        idx = i;
        render();
        root.style.display = 'grid';
        document.documentElement.style.overflow = 'hidden';
      },
    };
  }

  for (const carousel of document.querySelectorAll<HTMLElement>('[data-img-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('.ic-track');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.ic-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.ic-dot'));
    const prev = carousel.querySelector<HTMLButtonElement>('.ic-prev');
    const next = carousel.querySelector<HTMLButtonElement>('.ic-next');
    const zooms = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.ic-zoom'));
    if (!track || slides.length < 1) continue;

    let current = 0;

    const sync = (i: number) => {
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    function goTo(i: number) {
      i = Math.max(0, Math.min(i, slides.length - 1));
      current = i;
      track!.scrollTo({ left: i * track!.clientWidth, behavior: 'smooth' });
      sync(i);
    }

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

    let scrollTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const i = Math.round(track.scrollLeft / (track.clientWidth || 1));
        if (i !== current) { current = i; sync(i); }
      }, 60);
    });

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
    });

    goTo(0);

    // The lightbox holds the whole gallery so a tapped image can be swiped through.
    const shots = zooms.map((btn) => {
      const img = btn.querySelector('img');
      return { src: btn.dataset.full || img?.currentSrc || img?.src || '', alt: img?.alt || '' };
    });
    zooms.forEach((btn, i) => {
      btn.addEventListener('click', () => getLightbox().open(shots, i));
    });
  }
</script>
