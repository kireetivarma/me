---
import type { CollectionEntry } from 'astro:content';
import { resolveArt } from './art/index';
import { testimonialsFor } from '../data/testimonials';
import * as simpleIcons from 'simple-icons';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, summary, categories, metrics, art, accent, role, timeframe, decision, partners } = project.data;
const Art = resolveArt(art);
const topMetric = metrics[0];
const testimonial = testimonialsFor(project.id)[0];
const showPartners = partners && partners.length >= 2;

const PARTNER_ICON_KEYS: Record<string, string> = {
  'OnePlus': 'siOneplus',
};
const partnerIcons = showPartners
  ? partners!.slice(0, 8).map((name) => {
      const key = PARTNER_ICON_KEYS[name] ?? ('si' + name.replace(/\s+/g, '').replace(/[^a-zA-Z0-9]/g, ''));
      const icon = (simpleIcons as Record<string, unknown>)[key] as any;
      return { name, icon };
    })
  : [];
---

<a
  href={`/work/${project.id}/`}
  class="project-card"
  data-categories={categories.map((c) => c.toLowerCase()).join(' ')}
  style={accent ? `--accent:${accent}` : undefined}
>
  <div class="card-art">
    <Art size="thumb" />
  </div>
  <div class="card-body">
    <div class="card-tags">
      {categories.map((c) => <span class="tag">{c}</span>)}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-summary">{summary}</p>
    {
      decision && (
        <p class="card-decision">
          <span class="decision-label art-mono">decision</span>
          {decision}
        </p>
      )
    }
    {
      testimonial && (
        <p class="card-quote">
          “{testimonial.short}” <span class="quote-by">· {testimonial.author}</span>
        </p>
      )
    }
    {
      showPartners && (
        <div class="card-partners">
          {partnerIcons.map(({ name, icon }) => (
            <div class="partner-icon" title={name}>
              {icon ? (
                <svg viewBox="0 0 24 24" class="p-logo" role="img" aria-label={name}>
                  <path d={icon.path} />
                </svg>
              ) : (
                <span class="partner-text">{name}</span>
              )}
            </div>
          ))}
        </div>
      )
    }
    <div class="card-foot">
      {topMetric && (
        <span class="card-metric">
          <b class="metric-value">{topMetric.value}</b> {topMetric.label}
        </span>
      )}
      <span class="card-meta">{role} · {timeframe}</span>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, box-shadow 0.3s, background 0.3s;
    position: relative;
  }
  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-hover);
  }
  .card-art {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background: var(--bg-2);
  }
  .card-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .card-title {
    font-size: var(--text-xl);
    color: var(--text-1);
  }
  .card-summary {
    color: var(--text-2);
    font-size: var(--text-sm);
    flex: 1;
  }
  .card-decision {
    font-size: var(--text-xs);
    color: var(--text-3);
    line-height: 1.55;
  }
  .decision-label {
    display: inline-block;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    margin-right: 0.5rem;
    vertical-align: 1px;
  }
  .card-quote {
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--text-3);
    padding-left: 0.7rem;
    line-height: 1.55;
  }
  .quote-by {
    font-style: normal;
    white-space: nowrap;
  }
  .card-foot {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.4rem;
  }
  .card-metric {
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .metric-value {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 1.05em;
  }
  .card-meta {
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .card-partners {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
    overflow: hidden;
  }
  .partner-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .p-logo {
    width: 16px;
    height: 16px;
  }
  .p-logo :global(path) {
    fill: var(--text-3);
    transition: fill 0.2s;
  }
  .partner-icon:hover .p-logo :global(path) {
    fill: var(--text-1);
  }
  .partner-text {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    color: var(--text-3);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>
