---
import { profile } from '../data/profile';
import * as simpleIcons from 'simple-icons';

interface IconDef {
  path: string;
  hex: string;
  title: string;
}

const cells = profile.brands.map((b) => {
  const icon = 'icon' in b && b.icon ? ((simpleIcons as Record<string, unknown>)[b.icon] as IconDef | undefined) : undefined;
  const internalHref = 'slug' in b && b.slug ? `/work/${b.slug}/` : undefined;
  const externalHref = 'externalUrl' in b && b.externalUrl ? b.externalUrl : undefined;
  return {
    name: b.name,
    path: icon?.path,
    color: icon ? `#${icon.hex}` : ('color' in b ? b.color : undefined),
    href: internalHref ?? externalHref,
    external: !internalHref && Boolean(externalHref),
  };
});
---

<section class="section">
  <div class="container">
    <p class="section-label reveal">// collaborated with</p>
    <h2 class="section-title reveal">Global brands &amp; teams</h2>
    <p class="section-sub reveal">
      Partners and platforms I shipped with, many onboarded through the Shelf, AOD and Live Alerts partner program I built at OnePlus.
    </p>
    <div class="brand-grid stagger">
      {
        cells.map((b) => {
          const Tag = b.href ? 'a' : 'div';
          const rel = b.external ? 'noopener' : undefined;
          const target = b.external ? '_blank' : undefined;
          return (
            <Tag class="brand-cell" href={b.href} target={target} rel={rel} style={b.color ? `--brand:${b.color}` : undefined} title={b.name}>
              {b.path ? (
                <svg viewBox="0 0 24 24" class="brand-logo" role="img" aria-label={b.name}>
                  <path d={b.path} />
                </svg>
              ) : (
                <span class="brand-name">{b.name}</span>
              )}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .brand-cell {
    --brand: var(--text-1);
    background: var(--bg);
    padding: 1.7rem 1rem;
    display: grid;
    place-items: center;
    min-height: 86px;
    text-decoration: none;
    transition: background 0.3s;
  }
  .brand-cell:hover {
    background: var(--bg-card-hover);
  }
  .brand-logo {
    width: 34px;
    height: 34px;
  }
  .brand-logo path {
    fill: var(--text-3);
    transition: fill 0.3s;
  }
  .brand-cell:hover .brand-logo path {
    fill: var(--brand);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--text-3);
    letter-spacing: 0.01em;
    transition: color 0.3s;
    text-align: center;
  }
  .brand-cell:hover .brand-name {
    color: var(--brand);
  }
</style>
