---
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = profile.description,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogImage = '/og-default.png',
  publishedTime,
  jsonLd,
} = Astro.props;

const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  jobTitle: 'Senior Product Manager',
  sameAs: [profile.social.linkedin, profile.social.x],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${profile.name} · Posts`} href="/rss.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialTitle} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{ogType === 'article' && <meta property="article:author" content={profile.name} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@kireetivarma" />
<meta name="twitter:creator" content="@kireetivarma" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={socialTitle} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? personLd)} />
