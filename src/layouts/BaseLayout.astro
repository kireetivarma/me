---
import '../styles/global.css';
import '../styles/art.css';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
  accent?: string;
}

const { accent, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Set theme before first paint to avoid FOUC.
      (function () {
        var t = localStorage.getItem('kvTheme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        else if (window.matchMedia('(prefers-color-scheme: light)').matches)
          document.documentElement.dataset.theme = 'light';
      })();
    </script>
    <Seo {...seo} />
    {accent && <style set:html={`:root{--accent:${accent}}`}></style>}
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal: adds .in once when an element enters the viewport.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -5% 0px' }
      );
      document.querySelectorAll('.reveal, .stagger, .art').forEach((el) => io.observe(el));
    </script>

    <style>
      main {
        padding-top: 60px;
        min-height: 70vh;
      }
    </style>
  </body>
</html>
