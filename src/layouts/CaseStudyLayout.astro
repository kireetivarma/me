---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MetricsBand from '../components/MetricsBand.astro';
import SkillTags from '../components/SkillTags.astro';
import Announcements from '../components/Announcements.astro';
import PostCard from '../components/PostCard.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import { resolveArt } from '../components/art/index';
import { testimonialsFor } from '../data/testimonials';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
}

const { entry, prev, next } = Astro.props;
const {
  title,
  seoTitle,
  tagline,
  summary,
  categories,
  role,
  timeframe,
  team,
  skills,
  metrics,
  art,
  heroVideo,
  gallery,
  accent,
  externalUrl,
  relatedPosts,
  coverage,
  announcements,
} = entry.data;
const Art = resolveArt(art);
const hasGallery = gallery.length > 0;
// A self-hosted hero video wins the hero slot; the intro goes full-width above it.
const heroIsMedia = !!heroVideo || hasGallery;
const quotes = testimonialsFor(entry.id);

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const related = relatedPosts.map((slug) => allPosts.find((p) => p.id === slug)).filter((p) => p !== undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  headline: seoTitle ?? title,
  description: summary,
  url: new URL(`/work/${entry.id}/`, Astro.site).toString(),
  author: { '@type': 'Person', name: profile.name, url: 'https://kireetivarma.me' },
  keywords: categories.join(', '),
};
---

<BaseLayout title={`${seoTitle ?? title} · Kireeti Varma`} description={summary} accent={accent} jsonLd={jsonLd} ogImage={`/og/${entry.id}.png`}>
  <article>
    <header class="cs-header">
      <div class="cs-ambient" aria-hidden="true"><Art size="ambient" /></div>
      <div class="container">
        <div class:list={['cs-head-grid', { 'no-art': heroIsMedia }]}>
          <div class="cs-intro">
            <p class="cs-crumb art-mono"><a href="/work/">work</a> / {entry.id}</p>
            <h1 class="cs-title reveal">{title}</h1>
            <p class="cs-tagline reveal">{tagline}</p>
            <div class="cs-meta reveal">
              {categories.map((c) => <span class="tag">{c}</span>)}
              <span class="cs-role">{role} · {timeframe}</span>
            </div>
            {
              team && (team.led || team.collaborators) && (
                <div class="cs-team reveal">
                  {team.led && (
                    <p class="team-row">
                      <span class="team-label team-label-led">Led</span> {team.led}
                    </p>
                  )}
                  {team.collaborators && (
                    <p class="team-row">
                      <span class="team-label">Worked with</span> {team.collaborators}
                    </p>
                  )}
                </div>
              )
            }
            {
              externalUrl && (
                <a href={externalUrl} target="_blank" rel="noopener" class="btn btn-outline cs-visit reveal" data-ga-event="external_project_visit">
                  Visit {new URL(externalUrl).hostname} ↗
                </a>
              )
            }
          </div>
          {
            !heroIsMedia && (
              <div class="cs-hero-art reveal">
                <Art size="hero" />
              </div>
            )
          }
        </div>
        {
          heroVideo && (
            <div class="cs-video-hero reveal">
              <video
                id="cs-hero-video"
                src={heroVideo}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={`${title} promo video`}
              />
              <button type="button" class="cs-video-audio" id="cs-video-audio" aria-pressed="false" aria-label="Unmute video">
                <svg class="ic-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor"/><path d="m17 9 4 6M21 9l-4 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <svg class="ic-unmuted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8 8 0 0 1 0 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                <span class="cs-video-audio-label">Sound off</span>
              </button>
            </div>
          )
        }
        {
          !heroVideo && hasGallery && (
            <div class="cs-gallery-hero reveal">
              <ImageCarousel images={gallery} />
            </div>
          )
        }
        <MetricsBand metrics={metrics} />
      </div>
    </header>

    <div class="container">
      <div class="prose cs-prose">
        <slot />
      </div>

      <SkillTags skills={skills} />

      <Announcements announcements={announcements} />

      {
        coverage.length > 0 && (
          <aside class="cs-coverage" id="coverage">
            <p class="section-label">// coverage</p>
            <ul class="coverage-list">
              {coverage.map((c) => (
                <li>
                  <a href={c.url} target="_blank" rel="noopener">
                    <b>{c.outlet}</b> · {c.title} ↗
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      {
        quotes.length > 0 && (
          <aside class="cs-quotes" aria-label="What collaborators say">
            {quotes.map((t) => (
              <figure class="cs-quote reveal">
                <blockquote>“{t.quote}”</blockquote>
                <figcaption>
                  <b>{t.author}</b> · {t.role} <span class="quote-rel">({t.relation})</span>
                </figcaption>
              </figure>
            ))}
          </aside>
        )
      }

      {
        related.length > 0 && (
          <aside class="cs-related">
            <p class="section-label">// deep dives</p>
            <h2 class="section-title">Read the full story</h2>
            <div class="related-grid stagger">
              {related.map((p) => <PostCard post={p} />)}
            </div>
          </aside>
        )
      }

      <aside class="cs-cta reveal">
        <div>
          <p class="cs-cta-title">Want this kind of thinking on your team?</p>
          <p class="cs-cta-sub">Response time: usually same day. No decks needed to start a conversation.</p>
        </div>
        <div class="cs-cta-actions">
          <a href={profile.social.calendly} target="_blank" rel="noopener" class="btn btn-primary">Book a call →</a>
          <a href={`mailto:${profile.email}`} class="btn btn-outline">Email me</a>
        </div>
      </aside>

      <nav class="cs-nav" aria-label="More case studies">
        {prev ? <a href={`/work/${prev.id}/`} class="cs-nav-link">← {prev.data.title}</a> : <span />}
        {next ? <a href={`/work/${next.id}/`} class="cs-nav-link next">{next.data.title} →</a> : <span />}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .cs-header {
    position: relative;
    padding: 3rem 0 1rem;
    overflow: hidden;
  }
  .cs-ambient {
    position: absolute;
    inset: -20%;
    opacity: 0.18;
    filter: blur(60px);
    pointer-events: none;
  }
  .cs-head-grid {
    display: grid;
    grid-template-columns: minmax(300px, 6fr) 5fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    position: relative;
  }
  @media (max-width: 820px) {
    .cs-head-grid { grid-template-columns: 1fr; }
  }
  /* When a gallery serves as the hero, the intro is full-width text above it. */
  .cs-head-grid.no-art {
    grid-template-columns: 1fr;
    align-items: start;
  }
  .cs-gallery-hero {
    margin-top: 2rem;
  }
  /* The carousel sets its own vertical rhythm; drop its default top margin here. */
  .cs-gallery-hero :global(.ic) {
    margin: 0;
  }
  .cs-video-hero {
    position: relative;
    margin-top: 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: #0c0d11;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .cs-video-hero video {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(72vh, 640px);
    object-fit: cover;
  }
  .cs-video-audio {
    position: absolute;
    bottom: 0.9rem;
    right: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(12, 13, 17, 0.66);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #f1f5f9;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .cs-video-audio:hover { background: rgba(12, 13, 17, 0.9); border-color: rgba(255, 255, 255, 0.32); }
  .cs-video-audio svg { width: 16px; height: 16px; }
  .cs-video-audio .ic-unmuted { display: none; }
  .cs-video-audio[aria-pressed='true'] .ic-muted { display: none; }
  .cs-video-audio[aria-pressed='true'] .ic-unmuted { display: inline; }
  .cs-crumb {
    font-size: var(--text-xs);
    color: var(--text-3);
    margin-bottom: 1.2rem;
  }
  .cs-crumb a { color: var(--text-3); text-decoration: none; }
  .cs-crumb a:hover { color: var(--text-1); }
  .cs-title {
    font-size: var(--text-hero);
    font-weight: 700;
    margin-bottom: 0.8rem;
  }
  .cs-tagline {
    font-size: var(--text-lg);
    color: var(--text-2);
    margin-bottom: 1.2rem;
    max-width: 50ch;
  }
  .cs-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .cs-role {
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .cs-team {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.4rem;
    max-width: 60ch;
  }
  .team-row {
    font-size: var(--text-xs);
    color: var(--text-2);
    letter-spacing: 0.02em;
    line-height: 1.6;
  }
  .team-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    margin-right: 0.4rem;
    vertical-align: 1px;
  }
  .team-label-led {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .cs-hero-art {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-2);
    overflow: hidden;
  }
  .cs-prose {
    margin: 3rem auto 0;
  }
  .cs-coverage {
    margin-top: 3.5rem;
    max-width: 70ch;
    scroll-margin-top: 80px;
  }
  .coverage-list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .coverage-list a {
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
  }
  .coverage-list a:hover {
    color: var(--text-1);
    border-color: var(--accent);
  }
  .coverage-list b {
    color: var(--text-1);
    font-weight: 600;
  }
  .cs-quotes {
    margin-top: 3.5rem;
    display: grid;
    gap: 1.2rem;
    max-width: 70ch;
  }
  .cs-quote {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 1.4rem 1.6rem;
  }
  .cs-quote blockquote {
    font-size: var(--text-base);
    font-style: italic;
    color: var(--text-2);
    margin-bottom: 0.8rem;
  }
  .cs-quote figcaption {
    font-size: var(--text-sm);
    color: var(--text-3);
  }
  .cs-quote figcaption b {
    color: var(--text-1);
    font-weight: 600;
  }
  .quote-rel {
    font-size: var(--text-xs);
  }
  .cs-related {
    margin-top: var(--space-section);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .cs-cta {
    margin-top: var(--space-section);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 60% 100% at 100% 100%, rgba(245, 5, 20, 0.1), transparent 70%),
      var(--bg-card);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .cs-cta-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--text-1);
    margin-bottom: 0.3rem;
  }
  .cs-cta-sub {
    font-size: var(--text-sm);
    color: var(--text-3);
  }
  .cs-cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .cs-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--space-section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .cs-nav-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    max-width: 45%;
  }
  .cs-nav-link:hover { color: var(--text-1); }
  .cs-nav-link.next { text-align: right; }
</style>

<script>
  // Hero video starts muted (required for autoplay); the toggle lets viewers
  // hear the promo audio on demand.
  const video = document.getElementById('cs-hero-video') as HTMLVideoElement | null;
  const toggle = document.getElementById('cs-video-audio');
  if (video && toggle) {
    const label = toggle.querySelector('.cs-video-audio-label');
    const sync = () => {
      const on = !video.muted;
      toggle.setAttribute('aria-pressed', String(on));
      toggle.setAttribute('aria-label', on ? 'Mute video' : 'Unmute video');
      if (label) label.textContent = on ? 'Sound on' : 'Sound off';
    };
    toggle.addEventListener('click', () => {
      video.muted = !video.muted;
      // Some browsers need an explicit play() after the user gesture.
      if (!video.muted) video.play().catch(() => {});
      sync();
    });
    sync();
  }
</script>
