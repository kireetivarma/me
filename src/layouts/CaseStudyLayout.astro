---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MetricsBand from '../components/MetricsBand.astro';
import PostCard from '../components/PostCard.astro';
import { resolveArt } from '../components/art/index';
import { getCollection } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
}

const { entry, prev, next } = Astro.props;
const { title, tagline, summary, categories, role, timeframe, metrics, art, accent, externalUrl, relatedPosts } =
  entry.data;
const Art = resolveArt(art);

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const related = relatedPosts.map((slug) => allPosts.find((p) => p.id === slug)).filter((p) => p !== undefined);
---

<BaseLayout title={`${title} — Kireeti Varma`} description={summary} accent={accent}>
  <article>
    <header class="cs-header">
      <div class="cs-ambient" aria-hidden="true"><Art size="ambient" /></div>
      <div class="container">
        <div class="cs-head-grid">
          <div class="cs-intro">
            <p class="cs-crumb art-mono"><a href="/work/">work</a> / {entry.id}</p>
            <h1 class="cs-title reveal">{title}</h1>
            <p class="cs-tagline reveal">{tagline}</p>
            <div class="cs-meta reveal">
              {categories.map((c) => <span class="tag">{c}</span>)}
              <span class="cs-role">{role} · {timeframe}</span>
            </div>
            {
              externalUrl && (
                <a href={externalUrl} target="_blank" rel="noopener" class="btn btn-outline cs-visit reveal">
                  Visit {new URL(externalUrl).hostname} ↗
                </a>
              )
            }
          </div>
          <div class="cs-hero-art reveal">
            <Art size="hero" />
          </div>
        </div>
        <MetricsBand metrics={metrics} />
      </div>
    </header>

    <div class="container">
      <div class="prose cs-prose">
        <slot />
      </div>

      {
        related.length > 0 && (
          <aside class="cs-related">
            <p class="section-label">// deep dives</p>
            <h2 class="section-title">Read the full story</h2>
            <div class="related-grid stagger">
              {related.map((p) => <PostCard post={p} />)}
            </div>
          </aside>
        )
      }

      <nav class="cs-nav" aria-label="More case studies">
        {prev ? <a href={`/work/${prev.id}/`} class="cs-nav-link">← {prev.data.title}</a> : <span />}
        {next ? <a href={`/work/${next.id}/`} class="cs-nav-link next">{next.data.title} →</a> : <span />}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .cs-header {
    position: relative;
    padding: 3rem 0 1rem;
    overflow: hidden;
  }
  .cs-ambient {
    position: absolute;
    inset: -20%;
    opacity: 0.18;
    filter: blur(60px);
    pointer-events: none;
  }
  .cs-head-grid {
    display: grid;
    grid-template-columns: minmax(300px, 6fr) 5fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    position: relative;
  }
  @media (max-width: 820px) {
    .cs-head-grid { grid-template-columns: 1fr; }
  }
  .cs-crumb {
    font-size: var(--text-xs);
    color: var(--text-3);
    margin-bottom: 1.2rem;
  }
  .cs-crumb a { color: var(--text-3); text-decoration: none; }
  .cs-crumb a:hover { color: var(--text-1); }
  .cs-title {
    font-size: var(--text-hero);
    font-weight: 700;
    margin-bottom: 0.8rem;
  }
  .cs-tagline {
    font-size: var(--text-lg);
    color: var(--text-2);
    margin-bottom: 1.2rem;
    max-width: 50ch;
  }
  .cs-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }
  .cs-role {
    font-size: var(--text-xs);
    color: var(--text-3);
  }
  .cs-hero-art {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-2);
    overflow: hidden;
  }
  .cs-prose {
    margin: 3rem auto 0;
  }
  .cs-related {
    margin-top: var(--space-section);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  .cs-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--space-section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .cs-nav-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-2);
    text-decoration: none;
    max-width: 45%;
  }
  .cs-nav-link:hover { color: var(--text-1); }
  .cs-nav-link.next { text-align: right; }
</style>
