---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { profile } from '../data/profile';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, categories, heroImage, heroImageAlt } = post.data;
const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Social preview: use the post's hero image (resized for OG cards) when it
// has one, falling back to the site default in Seo.astro otherwise.
const ogHero = heroImage
  ? await getImage({ src: heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(ogHero && { image: new URL(ogHero.src, Astro.site).toString() }),
  author: { '@type': 'Person', name: profile.name, url: 'https://kireetivarma.me' },
  mainEntityOfPage: new URL(`/post/${post.id}/`, Astro.site).toString(),
};
---

<BaseLayout
  title={`${title} · Kireeti Varma`}
  description={description}
  ogType="article"
  ogImage={ogHero?.src}
  publishedTime={pubDate}
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="container post-header">
      <p class="post-crumb art-mono"><a href="/posts/">posts</a> / {post.id}</p>
      <h1 class="post-title reveal">{title}</h1>
      <div class="post-meta reveal">
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        {categories.map((c) => <a href={`/posts/?category=${c.toLowerCase()}`} class="tag">{c}</a>)}
      </div>
      {
        heroImage && (
          <div class="post-hero reveal">
            <Image src={heroImage} alt={heroImageAlt ?? ''} width={1200} loading="eager" fetchpriority="high" />
          </div>
        )
      }
    </header>
    <div class="container">
      <div class="prose post-body">
        <slot />
      </div>
      <footer class="post-foot">
        <a href="/posts/" class="btn btn-outline">← All posts</a>
        <a href={profile.social.linkedin} target="_blank" rel="noopener" class="btn btn-outline">Discuss on LinkedIn</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    padding-top: 3rem;
    max-width: 880px;
  }
  .post-crumb {
    font-size: var(--text-xs);
    color: var(--text-3);
    margin-bottom: 1.2rem;
  }
  .post-crumb a { color: var(--text-3); text-decoration: none; }
  .post-crumb a:hover { color: var(--text-1); }
  .post-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-3);
    margin-bottom: 2rem;
  }
  .post-meta .tag { text-decoration: none; }
  .post-meta .tag:hover { color: var(--text-1); }
  .post-hero {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    margin-bottom: 1rem;
  }
  .post-hero :global(img) {
    width: 100%;
    height: auto;
  }
  .post-body {
    margin: 2rem auto 0;
  }
  .post-foot {
    max-width: 70ch;
    margin: 3.5rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
