---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import JourneySection from '../components/JourneySection.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import BrandGrid from '../components/BrandGrid.astro';
import PressStrip from '../components/PressStrip.astro';
import ContactSection from '../components/ContactSection.astro';
import PostCard from '../components/PostCard.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const HOME_HIDDEN_CATEGORIES = ['Personal', 'Review', 'Tech'];
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => p.data.categories.some((c) => !HOME_HIDDEN_CATEGORIES.includes(c)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Kireeti Varma · Senior Product Manager · ex-OnePlus · 200M+ Users globally"
  description="Senior Product Manager with 12+ years shipping OS products to 200M+ users across 50+ countries. Ex-OnePlus: drove 4x MAU growth on Shelf, 2x CTR on Scout, and built the industry-first partner-powered AOD experience with Zomato, Spotify and Snapchat. Open to Sr. PM and Product Lead roles in Canada and remote globally."
  ogTitle="Kireeti Varma · Senior Product Manager"
  ogDescription="Ex-OnePlus. 200M+ users. Industry-first AOD. Partnerships with Spotify, Snapchat, Zomato, Grab. Now building with AI in Canada. Open to Sr. PM roles."
>
  <Hero />

  <JourneySection />

  <section class="section" id="work">
    <div class="container">
      <p class="section-label reveal">// selected work</p>
      <h2 class="section-title reveal">Products, partnerships &amp; everything between</h2>
      <p class="section-sub reveal">
        20+ products across consumer tech, AI, fintech and design. Filter by what you care about.
      </p>
      <a href="/work/product-f/" class="now-building reveal">
        <span class="nb-label art-mono">// currently building</span>
        <span class="nb-name">Product f()</span>
        <span class="nb-desc">The AI operating system for product teams. Waitlist open →</span>
      </a>
      <ProjectGrid projects={work} />
    </div>
  </section>

  <BrandGrid />
  <PressStrip />

  {
    posts.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="section-label reveal">// latest writing</p>
          <h2 class="section-title reveal">Notes from the field</h2>
          <div class="latest-grid stagger">
            {posts.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
          <a href="/posts/" class="btn btn-outline all-posts reveal">
            All posts →
          </a>
        </div>
      </section>
    )
  }

  <ContactSection />
</BaseLayout>

<style>
  .now-building {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(90deg, rgba(139, 92, 246, 0.08), transparent 55%),
      var(--bg-card);
    padding: 1rem 1.3rem;
    margin-bottom: 1.8rem;
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s;
  }
  .now-building:hover {
    border-color: var(--border-hover);
  }
  .nb-label {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b5cf6;
  }
  .nb-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-1);
  }
  .nb-desc {
    font-size: var(--text-sm);
    color: var(--text-2);
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
</style>
