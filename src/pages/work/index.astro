---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import SkillsOverview from '../../components/SkillsOverview.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work · Kireeti Varma" description="20+ shipped products across consumer OS, AI, fintech and design, each documented from discovery through ops. OnePlus Shelf, Scout, AOD, Product f(), Labh, Petfolk and more.">
  <section class="section">
    <div class="container">
      <p class="section-label reveal">// work</p>
      <h1 class="section-title reveal">Case studies</h1>
      <p class="section-sub reveal">
        Real shipped products, each with the problem, the strategic bet, and the numbers it moved.
        Use the filters to explore by discipline.
      </p>
      <ProjectGrid projects={work} />
      <SkillsOverview projects={work} />
    </div>
  </section>
</BaseLayout>
