---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work · Kireeti Varma" description="Case studies: OnePlus Shelf, Scout, food delivery on AOD, Spotify partnership, Product f(), Labh, Petfolk and more, across AI, products, design, partnerships and fintech.">
  <section class="section">
    <div class="container">
      <p class="section-label reveal">// work</p>
      <h1 class="section-title reveal">Case studies</h1>
      <p class="section-sub reveal">
        Every project below is a real shipped product, with the problem, the bets, and the numbers.
        Use the filters to explore by discipline.
      </p>
      <ProjectGrid projects={work} />
    </div>
  </section>
</BaseLayout>
