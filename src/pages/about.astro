---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { profile } from '../data/profile';

const tools = ['Figma', 'Sketch', 'Miro', 'Claude & LLM tooling', 'Bubble', 'Power BI', 'Google Analytics', 'UserTesting', 'Asana', 'Trello'];
---

<BaseLayout title="About · Kireeti Varma" description="Product leader, ex-OnePlus, 12+ years shipping OS products to 200M+ users. From PM, Global Apps to Lead, Product Strategy: partnerships, worldwide research, and the AI-native products built today.">
  <section class="section">
    <div class="container about">
      <p class="section-label reveal">// about</p>
      <h1 class="section-title reveal">Pixels first.<br />Then platforms. Now intelligence.</h1>

      <div class="about-grid">
        <div class="prose about-prose reveal">
          <p>
            I'm Kireeti, a product leader with <strong>12+ years building software</strong> and 7+ years in product
            management. I started as a designer, learned to build, and grew into owning products used by hundreds of
            millions of people.
          </p>
          <p>
            At <strong>OnePlus</strong> I grew across three roles in six years. As <strong>Product Manager, Global
            Apps</strong>, I shipped core OxygenOS apps (Shelf, Scout, Nearby Charging Stations, Notes), working
            closely with Android AOSP and Google. As <strong>Senior PM, Partnerships &amp; New Initiatives</strong>,
            I owned next-OS research and authored the partnership strategy that opened Shelf to third-party developers,
            growing partner engagement across the OS and onboarding
            <strong>Spotify, Snapchat, Netflix, Zomato, Blinkit, Swiggy and Grab</strong>. As <strong>Lead, Product
            Strategy</strong>, I ran worldwide user research (surveys, FGDs, IDIs) for global software and hardware
            strategy, greenlighting features each cycle with executive pitch decks. I trained 2 PMs and was named
            <strong>Employee of the Year 2021</strong>.
          </p>
          <p>
            Before OnePlus, I founded a product design agency (clients across fintech and health: Cabdost, Dvara
            Money, Leucine and Station91) and co-founded <strong>Imux</strong>, a seed-funded
            natural-language-interface-to-databases SaaS.
          </p>
          <p>
            Today I build AI-native products end-to-end: <a href="/work/product-f/">Product f()</a>, an AI operating
            system for product teams, plus <a href="/work/petfolk/">Petfolk</a>, <a href="/work/labh/">Labh</a>,
            <a href="/work/pro-studio-space/">Pro Studio</a> and <a href="/work/itihasa-collective/">Itihasa Collective</a>.
            A forward-deployed way of working: close to the problem, fast from idea to shipped, with AI in the loop.
          </p>
          <p>Based in {profile.location}.</p>
        </div>

        <aside class="about-side reveal">
          <a href="/files/Kireeti-Varma-Resume.pdf" download class="btn btn-primary resume-btn">Download resume ↓</a>
          <div class="side-block">
            <h2 class="side-title art-mono">// highlights</h2>
            <ul class="side-list">
              <li>200M+ users reached across 50+ countries</li>
              <li>OnePlus Employee of the Year 2021</li>
              <li>Authored the OnePlus partner program (Spotify, Snap, Zomato, Grab and more)</li>
              <li>Ran worldwide user research: surveys, FGDs, IDIs</li>
              <li>Trained 2 product managers</li>
              <li>20+ products built &amp; shipped, 1x founder (seed-funded Imux)</li>
              <li>SEBI-certified fintech (Labh)</li>
              <li>~₹1.5 Cr recovered for 5,000 drivers (Cabdost)</li>
            </ul>
          </div>
          <div class="side-block">
            <h2 class="side-title art-mono">// toolkit</h2>
            <div class="side-tags">
              {tools.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
          <div class="side-block">
            <h2 class="side-title art-mono">// elsewhere</h2>
            <ul class="side-list links">
              <li><a href={profile.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
              <li><a href={profile.social.x} target="_blank" rel="noopener">X / Twitter ↗</a></li>
              <li><a href={profile.social.calendly} target="_blank" rel="noopener">Calendly ↗</a></li>
              <li>
                <a
                  href="https://kireetivarma.notion.site/kireetivarma/Kireeti-Varma-Career-Wiki-7958149644ac457ba72d0b1ac02a0479"
                  target="_blank"
                  rel="noopener"
                >
                  Career wiki (Notion) ↗
                </a>
              </li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <ContactSection />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(300px, 7fr) 4fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: 2.5rem;
  }
  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
  }
  .resume-btn {
    width: 100%;
    justify-content: center;
    margin-bottom: 1.2rem;
  }
  .side-block {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    padding: 1.4rem;
    margin-bottom: 1.2rem;
  }
  .side-title {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.9rem;
  }
  .side-list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    color: var(--text-2);
    font-size: var(--text-sm);
  }
  .side-list li::before {
    content: '· ';
    color: var(--text-3);
  }
  .side-list.links li::before { content: ''; }
  .side-list a { color: var(--text-1); text-decoration: none; }
  .side-list a:hover { color: var(--red); }
  .side-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
